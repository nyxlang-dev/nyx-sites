enum Shape {
    Circle(int),
    Square(int),
    Rect(int, int)
}

fn area(s: Shape) -> int {
    return match s {            // exhaustive: every variant must be covered
        Shape.Circle(r)  => 3 * r * r,
        Shape.Square(l)  => l * l,
        Shape.Rect(w, h) => w * h
    }
}

fn main() {
    let rect: Shape = Shape.Rect(3, 7)
    print("area = ${area(rect)}")
}
