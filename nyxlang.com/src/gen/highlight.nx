// src/gen/highlight.nx — resaltado de sintaxis del generador estático.
//
// Tres entradas públicas:
//   hl_nyx(src)        código Nyx  → HTML con <span class="kw|str|cm|num|ty|fn|op">
//   hl_shell(src)      terminal    → <span class="prompt">$</span> + <span class="cmd">…</span>
//   hl_pre_blocks(h)   fragmento HTML → resalta el contenido de cada
//                      <pre data-lang="nyx"> / <pre data-lang="sh">
//
// ── Contrato ────────────────────────────────────────────────────────────────
// · TODO el texto pasa por html_escape (std/url) ANTES de envolverse en un
//   span, así que la salida nunca puede romper el HTML de la página.
// · Se conserva cada byte de la entrada: espacios, tabs y saltos de línea salen
//   tal cual, así los números de línea no se mueven y el `pre` se ve igual que
//   el archivo. La prueba de esto es un test: quitarle los tags a la salida
//   devuelve la entrada.
// · Es un escáner LÉXICO de una pasada, no un parser: no sabe de tipos ni de
//   ámbitos, y no puede equivocarse "peligrosamente" — en el peor caso pinta un
//   token con la clase de al lado. Decisión concreta de esa línea: la
//   interpolación `${…}` NO se resalta aparte, el string entero queda como
//   `str` (resaltar adentro pediría re-entrar al escáner recursivamente por un
//   detalle que en un ejemplo corto no aporta).
//
// ── Por qué a mano y no con regex ───────────────────────────────────────────
// std/regex encuentra y reemplaza, pero no devuelve POSICIONES, y acá hace
// falta recorrer la entrada de izquierda a derecha decidiendo por contexto (lo
// que va después de `//` es comentario aunque parezca código, lo que va dentro
// de comillas es string aunque parezca un comentario). Es el mismo escáner de
// bytes de una pasada que usa std/template.nx.
//
// ── Cobertura léxica ────────────────────────────────────────────────────────
// La lista de palabras clave sale de `is_keyword` en compiler/lexer.nx del
// monorepo, más las CONTEXTUALES (`type`, `spawn`, `select`, `macro`, `self`,
// `mut`), que el lexer emite como identificadores y el parser reconoce por
// posición: para el ojo del lector son palabras clave igual.
// Los comentarios de bloque `/* */` SÍ existen y ANIDAN (compiler/lexer.nx,
// skip_block_comment lleva un contador de profundidad) — el comentario de la
// cabecera de ese archivo que dice lo contrario está viejo.

import "std/url"  // html_escape

// Bytes que no se pueden escribir como literal de char sin escapes.
const B_QUOTE: int = 34    // "
const B_APOS: int = 39     // '
const B_BSLASH: int = 92   // \
const B_NL: int = 10       // \n
const B_CR: int = 13       // \r
const B_TAB: int = 9
const B_SP: int = 32

// ── Utilidades de bytes ─────────────────────────────────────────────────────

// Byte en una posición, o -1 fuera de rango. Todo el escáner lee por acá para
// no depender del cortocircuito de `and` al mirar el byte siguiente.
fn byte_at(s: String, i: int) -> int {
    if i < 0 { return -1 }
    if i >= s.length() { return -1 }
    return s.charAt(i)
}

fn is_digit(c: int) -> bool {
    if c >= '0' and c <= '9' { return true }
    return false
}

fn is_hex(c: int) -> bool {
    if is_digit(c) { return true }
    if c >= 'a' and c <= 'f' { return true }
    if c >= 'A' and c <= 'F' { return true }
    return false
}

fn is_alpha(c: int) -> bool {
    if c >= 'a' and c <= 'z' { return true }
    if c >= 'A' and c <= 'Z' { return true }
    if c == '_' { return true }
    return false
}

fn is_ident_byte(c: int) -> bool {
    if is_alpha(c) { return true }
    return is_digit(c)
}

fn is_upper(c: int) -> bool {
    if c >= 'A' and c <= 'Z' { return true }
    return false
}

// Operadores y puntuación. Una corrida de estos bytes se pinta como UN span
// (`->`, `=>`, `==`, `),` …) en vez de un span por byte: menos HTML y el mismo
// resultado visual.
fn is_op_byte(c: int) -> bool {
    if c == '+' or c == '-' or c == '*' or c == '/' or c == '%' { return true }
    if c == '=' or c == '<' or c == '>' or c == '!' or c == '?' { return true }
    if c == '&' or c == '|' or c == '^' or c == '~' { return true }
    if c == '.' or c == ',' or c == ':' or c == ';' { return true }
    if c == '(' or c == ')' or c == '{' or c == '}' { return true }
    if c == '[' or c == ']' { return true }
    return false
}

// ── Léxico de Nyx ───────────────────────────────────────────────────────────

// Palabras clave del lexer (compiler/lexer.nx `is_keyword`) …
fn is_keyword(w: String) -> bool {
    if w == "let" or w == "var" or w == "const" or w == "fn" { return true }
    if w == "return" or w == "if" or w == "else" or w == "while" { return true }
    if w == "for" or w == "in" or w == "break" or w == "continue" { return true }
    if w == "struct" or w == "enum" or w == "match" or w == "export" { return true }
    if w == "import" or w == "from" or w == "true" or w == "false" { return true }
    if w == "and" or w == "or" or w == "not" or w == "impl" { return true }
    if w == "trait" or w == "test" or w == "assert" or w == "extern" { return true }
    if w == "as" or w == "unsafe" or w == "static" or w == "sizeof" { return true }
    if w == "alignof" or w == "asm" or w == "dyn" or w == "pub" { return true }
    if w == "module" or w == "where" or w == "defer" or w == "try" { return true }
    if w == "catch" or w == "throw" or w == "async" or w == "await" { return true }
    // … más las contextuales (identificadores para el lexer, palabras clave
    // para el parser y para el lector).
    if w == "type" or w == "spawn" or w == "select" or w == "macro" { return true }
    if w == "self" or w == "mut" { return true }
    return false
}

// Tipos primitivos en minúscula. Los demás (String, Array, Map, Option,
// Result, Error, Fn…) caen en la regla general de "empieza en mayúscula".
fn is_builtin_type(w: String) -> bool {
    if w == "int" or w == "float" or w == "bool" { return true }
    if w == "char" or w == "void" { return true }
    return false
}

// ── Escaneo de tokens: cada scan_* devuelve el índice del PRIMER byte que ya
//    no pertenece al token ───────────────────────────────────────────────────

fn scan_line_comment(src: String, start: int) -> int {
    var j: int = start + 2
    while byte_at(src, j) >= 0 and byte_at(src, j) != B_NL { j = j + 1 }
    return j
}

// Comentario de bloque, con anidamiento (igual que el lexer del compilador).
// Sin cerrar → hasta el fin de la entrada: el resaltado degrada, no explota.
fn scan_block_comment(src: String, start: int) -> int {
    let n: int = src.length()
    var depth: int = 1
    var j: int = start + 2
    while j < n {
        let c: int = src.charAt(j)
        let c2: int = byte_at(src, j + 1)
        if c == '/' and c2 == '*' {
            depth = depth + 1
            j = j + 2
        } else {
            if c == '*' and c2 == '/' {
                depth = depth - 1
                j = j + 2
                if depth == 0 { return j }
            } else {
                j = j + 1
            }
        }
    }
    return n
}

// String ("…") o literal de char ('…'), con `\"` y `\\`. Un literal sin cerrar
// corta en el fin de línea para no teñir el resto del archivo.
fn scan_quoted(src: String, start: int, quote: int) -> int {
    let n: int = src.length()
    var j: int = start + 1
    while j < n {
        let c: int = src.charAt(j)
        if c == B_BSLASH {
            j = j + 2
        } else {
            if c == quote { return j + 1 }
            if c == B_NL { return j }
            j = j + 1
        }
    }
    return n
}

// Números: 10, 1_000, 0xFF, 0b1010, 0o755, 3.14, 1e9, 1.5e-3.
// El `.` solo entra si le sigue un dígito, así `0..10` y `1.method()` cortan
// el número donde corresponde.
fn scan_number(src: String, start: int) -> int {
    var j: int = start
    let c1: int = byte_at(src, start + 1)
    if src.charAt(start) == '0' {
        if c1 == 'x' or c1 == 'X' {
            j = start + 2
            while is_hex(byte_at(src, j)) or byte_at(src, j) == '_' { j = j + 1 }
            return j
        }
        if c1 == 'b' or c1 == 'B' or c1 == 'o' or c1 == 'O' {
            j = start + 2
            while is_digit(byte_at(src, j)) or byte_at(src, j) == '_' { j = j + 1 }
            return j
        }
    }
    while is_digit(byte_at(src, j)) or byte_at(src, j) == '_' { j = j + 1 }
    if byte_at(src, j) == '.' and is_digit(byte_at(src, j + 1)) {
        j = j + 1
        while is_digit(byte_at(src, j)) or byte_at(src, j) == '_' { j = j + 1 }
    }
    let e: int = byte_at(src, j)
    if e == 'e' or e == 'E' {
        var k: int = j + 1
        let sign: int = byte_at(src, k)
        if sign == '+' or sign == '-' { k = k + 1 }
        if is_digit(byte_at(src, k)) {
            j = k
            while is_digit(byte_at(src, j)) { j = j + 1 }
        }
    }
    return j
}

fn scan_ident(src: String, start: int) -> int {
    var j: int = start
    while is_ident_byte(byte_at(src, j)) { j = j + 1 }
    return j
}

// Corrida de operadores. Corta antes de `//` y de `/*` para que `x =// nota`
// no se coma el inicio del comentario dentro del span de operadores.
fn scan_ops(src: String, start: int) -> int {
    var j: int = start
    while is_op_byte(byte_at(src, j)) {
        if j > start and byte_at(src, j) == '/' {
            let nx: int = byte_at(src, j + 1)
            if nx == '/' or nx == '*' { return j }
        }
        j = j + 1
    }
    return j
}

// Clase de un identificador ya escaneado. El ORDEN importa y es el del brief:
// palabra clave gana sobre tipo, y tipo gana sobre llamada — por eso el
// constructor de una variante (`Shape.Circle(2)`) sale como `ty` y no como
// `fn`: es un nombre de tipo aunque esté seguido de paréntesis.
// "" = texto plano (una variable, un campo, un binding de patrón).
fn classify_ident(src: String, word: String, after: int) -> String {
    if is_keyword(word) { return "kw" }
    if is_builtin_type(word) { return "ty" }
    let first: int = word.charAt(0)
    if is_upper(first) { return "ty" }
    // Llamada: el siguiente byte que no sea espacio o tab es `(`. No se saltan
    // saltos de línea a propósito (un `(` en la línea de abajo no es la llamada
    // de este identificador).
    var j: int = after
    while byte_at(src, j) == B_SP or byte_at(src, j) == B_TAB { j = j + 1 }
    if byte_at(src, j) == '(' { return "fn" }
    return ""
}

// ── Salida ──────────────────────────────────────────────────────────────────

// Envuelve texto ya tokenizado en un span, escapándolo. Nunca se emite HTML sin
// pasar por acá o por html_escape directo.
fn wrap(cls: String, text: String) -> String {
    let safe: String = html_escape(text)
    return "<span class=\"" + cls + "\">" + safe + "</span>"
}

// ── API pública ─────────────────────────────────────────────────────────────

// Código Nyx → HTML resaltado. Preserva cada byte de la entrada.
pub fn hl_nyx(src: String) -> String {
    var out: Array = []
    let n: int = src.length()
    var i: int = 0
    var plain_start: int = 0   // inicio del texto plano todavía sin emitir
    while i < n {
        let c: int = src.charAt(i)
        let c2: int = byte_at(src, i + 1)
        var tok_end: int = -1
        var tok_cls: String = ""
        if c == '/' and c2 == '/' {
            tok_end = scan_line_comment(src, i)
            tok_cls = "cm"
        } else {
            if c == '/' and c2 == '*' {
                tok_end = scan_block_comment(src, i)
                tok_cls = "cm"
            } else {
                if c == B_QUOTE or c == B_APOS {
                    tok_end = scan_quoted(src, i, c)
                    tok_cls = "str"
                } else {
                    if is_digit(c) {
                        tok_end = scan_number(src, i)
                        tok_cls = "num"
                    } else {
                        if is_alpha(c) {
                            tok_end = scan_ident(src, i)
                            let word: String = src.substring(i, tok_end)
                            tok_cls = classify_ident(src, word, tok_end)
                        } else {
                            if is_op_byte(c) {
                                tok_end = scan_ops(src, i)
                                tok_cls = "op"
                            }
                        }
                    }
                }
            }
        }
        if tok_end > i {
            if i > plain_start {
                let plain: String = src.substring(plain_start, i)
                let plain_html: String = html_escape(plain)
                out.push(plain_html)
            }
            let raw: String = src.substring(i, tok_end)
            if tok_cls == "" {
                // Identificador sin clase: sale escapado y sin span.
                let raw_html: String = html_escape(raw)
                out.push(raw_html)
            } else {
                let span: String = wrap(tok_cls, raw)
                out.push(span)
            }
            i = tok_end
            plain_start = i
        } else {
            // Blancos y cualquier otro byte (UTF-8 incluido): texto plano.
            i = i + 1
        }
    }
    if n > plain_start {
        let tail: String = src.substring(plain_start, n)
        let tail_html: String = html_escape(tail)
        out.push(tail_html)
    }
    return out.join("")
}

// Bloque de terminal → HTML. Una línea que empieza con "$ " es un comando (el
// `$` en .prompt, el resto en .cmd); cualquier otra línea es salida del
// programa y va como texto plano escapado.
pub fn hl_shell(src: String) -> String {
    var out: Array = []
    let n: int = src.length()
    var i: int = 0
    while i < n {
        var j: int = i
        while byte_at(src, j) >= 0 and byte_at(src, j) != B_NL { j = j + 1 }
        let line: String = src.substring(i, j)
        if line.startsWith("$ ") {
            let rest: String = line.substring(2, line.length())
            let prompt: String = wrap("prompt", "$")
            out.push(prompt)
            out.push(" ")
            let cmd: String = wrap("cmd", rest)
            out.push(cmd)
        } else {
            let plain: String = html_escape(line)
            out.push(plain)
        }
        if j < n { out.push("\n") }
        i = j + 1
    }
    return out.join("")
}

// Des-escapa las entidades que produce html_escape. `&amp;` va ÚLTIMO para que
// `&amp;lt;` vuelva a ser `&lt;` y no `<`.
pub fn html_unescape_min(s: String) -> String {
    let a: String = s.replace("&lt;", "<")
    let b: String = a.replace("&gt;", ">")
    let c: String = b.replace("&quot;", "\"")
    let d: String = c.replace("&#x27;", "'")
    let e: String = d.replace("&#39;", "'")
    let f: String = e.replace("&amp;", "&")
    return f
}

// INVERSO del resaltado: saca todos los tags y des-escapa las entidades, o sea
// devuelve el texto que el lector ve (y copia) en la página.
//
// Existe para poder AFIRMAR la propiedad central de este módulo —
// hl_plain(hl_nyx(src)) == src — en los tests y, sobre todo, en el generador
// antes de publicar: si el resaltado alterara un byte del código de la landing,
// la generación falla en vez de publicar un ejemplo que no compila.
pub fn hl_plain(html: String) -> String {
    var out: Array = []
    let n: int = html.length()
    var i: int = 0
    var text_start: int = 0
    while i < n {
        if html.charAt(i) == '<' {
            let close: int = html.indexOf(">", i)
            if close < 0 { i = n } else {
                if i > text_start {
                    let piece: String = html.substring(text_start, i)
                    out.push(piece)
                }
                i = close + 1
                text_start = i
            }
        } else {
            i = i + 1
        }
    }
    if n > text_start {
        let tail: String = html.substring(text_start, n)
        out.push(tail)
    }
    let joined: String = out.join("")
    return html_unescape_min(joined)
}

// Resalta el contenido de cada <pre data-lang="nyx"> / <pre data-lang="sh"> de
// un fragmento HTML. Los <pre> sin data-lang quedan intactos — ese es el canal
// para HTML que YA viene resaltado (la muestra de la landing).
//
// El contenido de un fragmento es HTML, o sea que el código va escapado; acá se
// des-escapa antes de tokenizar y el tokenizador lo vuelve a escapar. No se
// admiten <pre> anidados (HTML tampoco) ni data-lang con comillas simples.
pub fn hl_pre_blocks(html: String) -> String {
    var out: Array = []
    let n: int = html.length()
    var pos: int = 0
    while pos < n {
        let open: int = html.indexOf("<pre", pos)
        if open < 0 {
            let tail: String = html.substring(pos, n)
            out.push(tail)
            pos = n
        } else {
            let gt: int = html.indexOf(">", open)
            if gt < 0 {
                // Etiqueta sin cerrar: se copia lo que queda y se sale.
                let tail2: String = html.substring(pos, n)
                out.push(tail2)
                pos = n
            } else {
                let tag: String = html.substring(open, gt + 1)
                var lang: String = ""
                if tag.contains("data-lang=\"nyx\"") { lang = "nyx" }
                if tag.contains("data-lang=\"sh\"") { lang = "sh" }
                let close: int = html.indexOf("</pre>", gt)
                if lang == "" or close < 0 {
                    let head: String = html.substring(pos, gt + 1)
                    out.push(head)
                    pos = gt + 1
                } else {
                    let head2: String = html.substring(pos, gt + 1)
                    out.push(head2)
                    let inner: String = html.substring(gt + 1, close)
                    let code: String = html_unescape_min(inner)
                    if lang == "nyx" {
                        let hi: String = hl_nyx(code)
                        out.push(hi)
                    } else {
                        let hi2: String = hl_shell(code)
                        out.push(hi2)
                    }
                    out.push("</pre>")
                    pos = close + 6
                }
            }
        }
    }
    return out.join("")
}
