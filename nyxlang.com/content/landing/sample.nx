fn fib(n: int) -> int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    let inputs = [38, 36, 34, 32]
    let done = channel_new(inputs.length())
    for n in inputs {
        spawn { channel_send(done, "fib(${n}) = ${fib(n)}") }      // one thread each
    }
    var lines: Array<String> = []
    for i in 0..inputs.length() { lines.push(channel_recv(done)) } // first to finish, first in
    for line in lines { print(line) }
}
