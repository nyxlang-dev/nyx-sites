// gen.nx — generador estático de nyxlang.com.
//
// Uso:
//   nyx gen.nx --out <dir> [--only landing|docs|by-example] [--check]
//
// El sitio dejó de ser HTML escrito a mano: cada página sale de un template
// (templates/) + contenido (content/) y se escribe en <dir>. Durante el
// rediseño <dir> es static-next/, que al final se intercambia con static/.
//
// --check no escribe en <dir>: genera todo en un directorio temporal
// (static-next.tmp/, gitignorado) y compara byte a byte contra <dir>,
// imprimiendo una línea « stale: <ruta> » por diferencia y saliendo 1 — el
// mismo contrato que `nyx_gendocs --check` del monorepo, para poder correrlo
// en CI y detectar salida sin regenerar. Compara los archivos que el
// generador PRODUCE; un archivo de más en <dir> no lo detecta (limitación
// conocida, igual que gendocs).
//
// Secciones: `landing` (la ficha) y `docs` (la guía de seis pasos, EN y ES).
// `by-example` está reconocida para que el flag no mienta, pero todavía no
// genera nada.

import "src/gen/content"
import "src/gen/render"
import "src/gen/highlight"

const CHECK_TMP_DIR: String = "static-next.tmp"

// ── Secciones ───────────────────────────────────────────────────────────────

// Genera la landing (EN + ES) en out_dir. Devuelve las rutas relativas escritas.
//
// El cuerpo sale de templates/index.html (UN solo template para los dos
// idiomas) + content/i18n/<lang>.toml. Los dos bloques largos que no caben en
// una clave de diccionario viajan por `extra` como HTML crudo:
//   · sample_code     — content/landing/sample.nx pasado por hl_nyx: el .nx es
//                       la ÚNICA copia del código, el HTML se deriva de él
//   · agents_excerpt  — content/landing/agents-<lang>.html, extracto LITERAL
//                       del AGENTS.md que siembra `nyx init`
// Los enlaces de los seis pasos de la guía se arman acá y no en el template
// porque el motor no concatena: la clave que llega ya trae el prefijo de
// idioma (/docs/… en inglés, /es/docs/… en español).
// Resalta un archivo .nx y VERIFICA que el resaltado sea transparente: sacarle
// los tags al HTML tiene que devolver el fuente byte a byte. Es la afirmación
// de la landing que cualquiera puede refutar copiando y pegando el bloque, así
// que preferimos fallar la generación antes que publicar un ejemplo alterado.
fn highlight_sample(path: String) -> String {
    let src: String = read_fragment(path)
    let html: String = hl_nyx(src)
    let back: String = hl_plain(html)
    if back != src {
        print("error: el resaltado alteró « " + path + " » — hl_plain(hl_nyx(src)) != src")
        exit(1)
    }
    return html
}

fn gen_landing(out_dir: String) -> Array {
    var written: Array = []
    let langs: Array = ["en", "es"]
    let sample: String = highlight_sample("content/landing/sample.nx")
    var i: int = 0
    while i < langs.length() {
        let lang: String = langs[i]
        var extra: Map = map_new()
        // Convención de src/gen/render.nx: se pasan CLAVES i18n, no textos.
        extra.insert("title_key", "title_home")
        extra.insert("desc_key", "meta_description")
        extra.insert("sample_code", sample)
        extra.insert("agents_excerpt", read_fragment("content/landing/agents-" + lang + ".html"))
        let docs: String = page_href("docs", lang)
        extra.insert("docs_install_href", docs + "01-install.html")
        extra.insert("docs_program_href", docs + "02-first-program.html")
        extra.insert("docs_project_href", docs + "03-project.html")
        extra.insert("docs_agents_href", docs + "04-agents.html")
        extra.insert("docs_cli_href", docs + "05-cli.html")
        extra.insert("docs_syntax_href", docs + "06-syntax.html")
        let html: String = render_page("index", lang, extra)
        let rel: String = page_rel("index", lang)
        write_page(out_dir, rel, html)
        written.push(rel)
        i = i + 1
    }
    return written
}

// ── Guía /docs ──────────────────────────────────────────────────────────────

// Número de paso con dos dígitos ("01"…"06"): es el que se ve en el sello, en
// el índice lateral y en el slug del archivo, y tiene que ser el mismo.
fn pad2(n: int) -> String {
    if n < 10 { return "0" + int_to_string(n) }
    return int_to_string(n)
}

// Las seis páginas de la guía, EN ORDEN. Cada una tiene dos identificadores:
//   · slug  — la URL y el nombre del fragmento (content/docs/<slug>.<lang>.html)
//   · stem  — la raíz de sus claves i18n: docs_<stem>_title / _note / _desc.
// Los `stem` son los que YA usa la landing para su lista de pasos, así el
// nombre de un paso se escribe una sola vez y no puede divergir entre la ficha,
// el índice de la guía y el índice lateral de cada página.
//
// Se devuelven como Arrays de String (no como un Array de Map): un Map anidado
// que vuelve de una función es uno de los gotchas del lenguaje, y acá no hace
// falta — los Maps de los ítems se arman dentro de gen_docs.
fn doc_slugs() -> Array {
    return ["01-install", "02-first-program", "03-project", "04-agents", "05-cli", "06-syntax"]
}
fn doc_stems() -> Array {
    return ["install", "program", "project", "agents", "cli", "syntax"]
}

// Genera el índice (/docs/, /es/docs/) y las seis páginas en los dos idiomas.
//
// Todo lo que el motor de templates no sabe hacer se precalcula acá y viaja en
// `extra`: las rutas (no concatena), los ítems del índice lateral con el paso
// activo marcado (no tiene condicionales sobre el ítem de afuera), y las URLs
// canónicas/alternas de cada página (no se derivan del nombre del template,
// porque los seis pasos comparten uno solo).
fn gen_docs(out_dir: String) -> Array {
    var written: Array = []
    let langs: Array = ["en", "es"]
    let slugs: Array = doc_slugs()
    let stems: Array = doc_stems()
    let total: String = pad2(slugs.length())
    let site: Map = load_site()
    let site_url: String = site.get_or("site_url", "")

    var li: int = 0
    while li < langs.length() {
        let lang: String = langs[li]
        let dict: Map = load_i18n(lang)
        let base: String = page_href("docs-index", lang)
        let suffix: String = dict.get_or("docs_page_suffix", "")

        // ── Índice: la lista de los seis, sin ninguno activo ──
        var idx_items: Array = []
        var s: int = 0
        while s < slugs.length() {
            let slug: String = slugs[s]
            let stem: String = stems[s]
            var item: Map = map_new()
            item.insert("num", pad2(s + 1))
            item.insert("href", base + slug + ".html")
            item.insert("title", dict.get_or("docs_" + stem + "_title", ""))
            item.insert("blurb", dict.get_or("docs_" + stem + "_note", ""))
            item.insert("active", "")
            item.insert("is_current", "")
            idx_items.push(item)
            s = s + 1
        }
        var iextra: Map = map_new()
        iextra.insert("title_key", "docs_index_title")
        iextra.insert("desc_key", "docs_index_desc")
        iextra.insert("steps", idx_items)
        let ihtml: String = render_page("docs-index", lang, iextra)
        let irel: String = page_rel("docs-index", lang)
        write_page(out_dir, irel, ihtml)
        written.push(irel)

        // ── Las seis páginas ──
        var p: int = 0
        while p < slugs.length() {
            let slug2: String = slugs[p]
            let stem2: String = stems[p]
            let num: String = pad2(p + 1)
            let title: String = dict.get_or("docs_" + stem2 + "_title", "")

            // El índice lateral se rearma por página porque cambia el activo.
            var toc: Array = []
            var t: int = 0
            while t < slugs.length() {
                // Los elementos de un Array se anotan SIEMPRE al leerlos: sin
                // el `: String` el compilador los trata como int y la ruta sale
                // con un número donde iba el slug (silencioso, no falla).
                let tslug: String = slugs[t]
                let tstem: String = stems[t]
                var titem: Map = map_new()
                titem.insert("num", pad2(t + 1))
                titem.insert("href", base + tslug + ".html")
                titem.insert("title", dict.get_or("docs_" + tstem + "_title", ""))
                if t == p {
                    titem.insert("active", " is-active")
                    titem.insert("is_current", "1")
                } else {
                    titem.insert("active", "")
                    titem.insert("is_current", "")
                }
                toc.push(titem)
                t = t + 1
            }

            var extra: Map = map_new()
            // El <title> es «<paso> — <sufijo>»: el motor no concatena, así que
            // se arma acá y se pasa ya resuelto (por eso no hay title_key).
            extra.insert("title", title + " — " + suffix)
            extra.insert("desc_key", "docs_" + stem2 + "_desc")
            extra.insert("page_title", title)
            extra.insert("num", num)
            extra.insert("total", total)
            extra.insert("steps", toc)
            extra.insert("doc_body", read_fragment("content/docs/" + slug2 + "." + lang + ".html"))
            // Rutas propias: el template es uno solo para los seis pasos, así
            // que canonical/hreflang NO pueden salir de su nombre.
            extra.insert("canonical_url", site_url + doc_href(slug2, lang))
            extra.insert("url_en", site_url + doc_href(slug2, "en"))
            extra.insert("url_es", site_url + doc_href(slug2, "es"))
            extra.insert("alt_href", doc_href(slug2, other_lang(lang)))

            // Anterior: el paso previo, o el índice de la guía en el primero.
            // Siguiente: el paso que viene; en el último no hay (el cierre de
            // la página 06 es el enlace al recetario, dentro del fragmento).
            if p == 0 {
                extra.insert("has_prev", "1")
                extra.insert("prev_href", base)
                extra.insert("prev_title", dict.get_or("docs_index_head", ""))
            } else {
                let pslug: String = slugs[p - 1]
                let pstem: String = stems[p - 1]
                extra.insert("has_prev", "1")
                extra.insert("prev_href", base + pslug + ".html")
                extra.insert("prev_title", dict.get_or("docs_" + pstem + "_title", ""))
            }
            if p + 1 < slugs.length() {
                let nslug: String = slugs[p + 1]
                let nstem: String = stems[p + 1]
                extra.insert("has_next", "1")
                extra.insert("next_href", base + nslug + ".html")
                extra.insert("next_title", dict.get_or("docs_" + nstem + "_title", ""))
            } else {
                extra.insert("has_next", "")
            }

            let html: String = render_page("docs-page", lang, extra)
            let rel: String = doc_rel(slug2, lang)
            write_page(out_dir, rel, html)
            written.push(rel)
            p = p + 1
        }
        li = li + 1
    }
    return written
}

// Copia los assets compartidos a <out>/shared/. Son texto (CSS/JS), así que
// read_file/write_file alcanzan; si algún día entra un binario hay que pasar a
// std/fs o a un copy del sistema.
fn gen_assets(out_dir: String) -> Array {
    var written: Array = []
    let names: Array = ["spec.css", "copy.js"]
    var i: int = 0
    while i < names.length() {
        let name: String = names[i]
        let text: String = read_fragment("assets/" + name)
        let rel: String = "shared/" + name
        write_page(out_dir, rel, text)
        written.push(rel)
        i = i + 1
    }
    return written
}

// Genera todo lo pedido por `only` ("" = todo) y devuelve las rutas escritas.
fn generate(out_dir: String, only: String) -> Array {
    var written: Array = []
    if only == "" or only == "landing" {
        let pages: Array = gen_landing(out_dir)
        var i: int = 0
        while i < pages.length() {
            let rel: String = pages[i]
            written.push(rel)
            i = i + 1
        }
    }
    if only == "" or only == "docs" {
        let docs: Array = gen_docs(out_dir)
        var d: int = 0
        while d < docs.length() {
            let rel3: String = docs[d]
            written.push(rel3)
            d = d + 1
        }
    }
    // Los assets compartidos los usa CUALQUIER página, así que van con
    // cualquier sección: generar sólo `docs` en un <out> vacío tiene que dejar
    // páginas que no estén sin hoja de estilo.
    if written.length() > 0 {
        let assets: Array = gen_assets(out_dir)
        var j: int = 0
        while j < assets.length() {
            let rel2: String = assets[j]
            written.push(rel2)
            j = j + 1
        }
    }
    return written
}

// ── --check ─────────────────────────────────────────────────────────────────

// Compara lo generado en tmp_dir contra out_dir. Devuelve la cantidad de
// archivos que difieren o faltan.
fn compare_tree(tmp_dir: String, out_dir: String, rels: Array) -> int {
    var stale: int = 0
    var i: int = 0
    while i < rels.length() {
        let rel: String = rels[i]
        let want_path: String = tmp_dir + "/" + rel
        let have_path: String = out_dir + "/" + rel
        let want: String = read_file(want_path)
        if file_exists(have_path) == false {
            print("stale: " + have_path + " (falta)")
            stale = stale + 1
        } else {
            let have: String = read_file(have_path)
            if have != want {
                print("stale: " + have_path)
                stale = stale + 1
            }
        }
        i = i + 1
    }
    return stale
}

fn run_check(out_dir: String, only: String) -> int {
    // Único lugar del generador que sale a shell: no hay borrado recursivo
    // nativo (mkdir sí es builtin, rmdir/unlink recursivo no), y el temporal
    // tiene que arrancar y quedar vacío para que la comparación signifique
    // algo. Todo lo demás — leer, crear directorios, escribir — usa builtins.
    exec_code("rm -rf '" + CHECK_TMP_DIR + "'")
    let rels: Array = generate(CHECK_TMP_DIR, only)
    let stale: int = compare_tree(CHECK_TMP_DIR, out_dir, rels)
    exec_code("rm -rf '" + CHECK_TMP_DIR + "'")
    if stale > 0 {
        print("gen: " + int_to_string(stale) + " archivo(s) desactualizado(s) en " + out_dir + " — hay que correr `make gen`")
        return 1
    }
    return 0
}

// ── CLI ─────────────────────────────────────────────────────────────────────

fn usage() {
    print("uso: nyx gen.nx --out <dir> [--only landing|docs|by-example] [--check]")
}

fn known_section(name: String) -> bool {
    if name == "landing" { return true }
    if name == "docs" { return true }
    if name == "by-example" { return true }
    return false
}

fn main() -> int {
    let args: Array = get_args()
    var out_dir: String = ""
    var only: String = ""
    var check: bool = false

    var i: int = 1
    while i < args.length() {
        let arg: String = args[i]
        if arg == "--out" {
            if i + 1 >= args.length() {
                print("error: --out requiere un directorio")
                usage()
                return 1
            }
            let val: String = args[i + 1]
            out_dir = val
            i = i + 2
        } else if arg == "--only" {
            if i + 1 >= args.length() {
                print("error: --only requiere una sección")
                usage()
                return 1
            }
            let val2: String = args[i + 1]
            only = val2
            i = i + 2
        } else if arg == "--check" {
            check = true
            i = i + 1
        } else {
            print("error: argumento desconocido « " + arg + " »")
            usage()
            return 1
        }
    }

    if out_dir == "" {
        print("error: falta --out <dir>")
        usage()
        return 1
    }
    if only != "" and known_section(only) == false {
        print("error: sección desconocida « " + only + " » (landing | docs | by-example)")
        return 1
    }

    if check {
        return run_check(out_dir, only)
    }

    let written: Array = generate(out_dir, only)
    if written.length() == 0 {
        print("gen: nada que generar para « " + only + " » (sección todavía no implementada)")
        return 0
    }
    let version: String = site_version()
    print("gen: v" + version + " → " + out_dir + " (" + int_to_string(written.length()) + " archivos)")
    var k: int = 0
    while k < written.length() {
        let rel: String = written[k]
        print("  " + rel)
        k = k + 1
    }
    return 0
}
