[Unit]
Description=edit.nyxlang.com — nyx-edit landing
After=network-online.target
Wants=network-online.target

[Service]
# Techo del heap del GC Boehm (decisión Ottavio 2026-07-25, opción 3 por-servicio).
# Al superarlo: abort ordenado (oom_fn, v0.22.3) + restart de systemd — nunca OOM-killer.
Environment=GC_MAXIMUM_HEAP_SIZE=134217728
Type=simple
User=admin
WorkingDirectory=/home/admin/nyx/web/sites/edit.nyxlang.com
ExecStart=/home/admin/nyx/web/sites/edit.nyxlang.com/edit-nyxlang-com
Environment=PORT=3009
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
